    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1",
    "zustand": "^5.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@fontsource-variable/inter": "^5.3.0",
